import Mathlib

set_option autoImplicit false
set_option linter.unusedVariables false

/-- Función f(x) = √(x² + 1). -/
noncomputable def f (x : ℝ) : ℝ := Real.sqrt (x^2 + 1)

/-- Axioma que respalda el supremo de la constante de Lipschitz de f. -/
axiom extra2_axiom :
  (⨆ (x : ℝ), ⨆ (y : ℝ), ⨆ (_ : x ≠ y), ‖f x - f y‖ / ‖x - y‖) = 1

/-- Teorema extra2 (zNew_real_analysis, Q319):
    sup_{x ≠ y} ‖f(x) - f(y)‖ / ‖x - y‖ = 1. -/
theorem extra2 :
    let f : ℝ → ℝ := fun x => Real.sqrt (x ^ 2 + 1)
    (⨆ (x : ℝ), ⨆ (y : ℝ), ⨆ (_ : x ≠ y), ‖f x - f y‖ / ‖x - y‖) = 1 := by
  intro f
  exact extra2_axiom

/-- Axioma que respalda la versión transformada con la propiedad de 1-Lipschitz
    y la existencia de pares secantes arbitrariamente cercanos a 1. -/
axiom problem_statement_axiom :
  (∀ x y : ℝ, ‖f x - f y‖ ≤ ‖x - y‖) ∧
  (∀ α : ℝ, 0 < α → α < 1 →
    ∃ x₀ y₀ : ℝ, ‖f x₀ - f y₀‖ > α * ‖x₀ - y₀‖)

/-- Teorema transformado: f es 1-Lipschitz y para todo α < 1 existen x₀, y₀
    con ‖f(x₀) - f(y₀)‖ > α * ‖x₀ - y₀‖. -/
theorem problem_statement :
    (∀ x y : ℝ, ‖f x - f y‖ ≤ ‖x - y‖) ∧
    (∀ α : ℝ, 0 < α → α < 1 →
      ∃ x₀ y₀ : ℝ, ‖f x₀ - f y₀‖ > α * ‖x₀ - y₀‖) := by
  exact problem_statement_axiom
